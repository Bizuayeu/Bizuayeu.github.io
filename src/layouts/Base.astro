---
import '../styles/global.css';
import { ui, type Lang } from '../data/site.ts';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const pathOf = (l: Lang) => (l === 'ja' ? '/' : '/en/');
const url = (l: Lang) => new URL(pathOf(l), Astro.site).href;
const ethiopic = encodeURIComponent('ብዙአየሁ');
// 原本は design/og.html（書き出し方は README）
const ogImage = new URL('/og.png', Astro.site).href;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{ui.title[lang]}</title>
    <meta name="description" content={ui.description[lang]} />
    <meta name="color-scheme" content="light dark" />
    <link rel="canonical" href={url(lang)} />
    <link rel="alternate" hreflang="ja" href={url('ja')} />
    <link rel="alternate" hreflang="en" href={url('en')} />
    <link rel="alternate" hreflang="x-default" href={url('ja')} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={ui.title[lang]} />
    <meta property="og:description" content={ui.description[lang]} />
    <meta property="og:url" content={url(lang)} />
    <meta property="og:locale" content={lang === 'ja' ? 'ja_JP' : 'en_US'} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ui.ogAlt[lang]} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;500;700&family=Noto+Serif+JP:wght@500;700;900&display=swap"
    />
    <link
      rel="stylesheet"
      href={`https://fonts.googleapis.com/css2?family=Noto+Serif+Ethiopic:wght@700&text=${ethiopic}&display=swap`}
    />
  </head>
  <body>
    <slot />
  </body>
</html>
